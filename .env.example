# Supabase
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# AI provider (OpenAI-compatible chat completions endpoint)
# Default: OpenRouter con gpt-oss-120b free (calidad alta, latencia 5-10s)
AI_API_KEY="sk-or-..."
AI_BASE_URL="https://openrouter.ai/api/v1/chat/completions"
AI_MODEL="openai/gpt-oss-120b:free"

# Modelo rápido OPCIONAL para práctica adaptativa (cae a AI_MODEL si no se setea).
# Útil para que la generación de ejercicios sea más veloz sin bajar calidad del tutor.
# AI_MODEL_FAST="meta-llama/llama-3.3-70b-instruct:free"

# --- Modelos free más rápidos (menor calidad, sub-3s en buen día) ---
# AI_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# AI_MODEL="z-ai/glm-4.5-air:free"
# AI_MODEL="qwen/qwen3-coder:free"
#
# --- Modelos pagos rápidos (recomendados para producción) ---
# AI_MODEL="google/gemini-2.5-flash-lite"
# AI_MODEL="openai/gpt-4o-mini"
# AI_MODEL="anthropic/claude-haiku-4-5"

# --- Alternativas (descomentar y cambiar AI_API_KEY) ---
# OpenAI:
# AI_BASE_URL="https://api.openai.com/v1/chat/completions"
# AI_MODEL="gpt-4o-mini"
#
# Groq:
# AI_BASE_URL="https://api.groq.com/openai/v1/chat/completions"
# AI_MODEL="llama-3.3-70b-versatile"
