{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matemathup",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Runtime vars. Supabase values below are placeholders: configure real values
  // in Cloudflare/hosting, or keep them in a local untracked config.
  // AI_API_KEY must be configured as a Cloudflare Secret, not committed here.
  "vars": {
    "SUPABASE_URL": "https://YOUR_PROJECT.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "your-publishable-key",
    "AI_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
    "AI_MODEL": "gemini-2.5-flash",
  },
}
